# ============ LLM Provider (OpenAI-compatible) ============
# Online now. To switch to Ollama later, ONLY change these three lines:
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5-coder:14b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=gpt-4o-mini

# Reasoning models (glm-5.x, o1/o3, deepseek-r) spend most of their latency
# before the first visible token: budget minutes, not seconds, per call.
# LLM_TIMEOUT_SECONDS=120
# Planning steps (JSON decisions) gain nothing from reasoning, so they run at
# minimal effort on those models -- 20s instead of 60s for the same reply.
# LLM_PLANNING_REASONING_EFFORT=minimal
# Never clip a streamed answer with a token ceiling: on a reasoning model the
# ceiling is spent on hidden reasoning and the answer arrives empty.
# LLM_MAX_TOKENS=0
# LLM_STREAM_MAX_TOKENS=0

# ============ Agentic document chat ============
# How many searches the chat agent may plan per question. Each one costs a
# planning call, so keep it low on slow models.
# CHAT_MAX_SEARCHES=3

# ============ Embeddings (separate from LLM on purpose) ============
# Decide this BEFORE M2 — changing it later means re-indexing Qdrant.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=text-embedding-3-small

# ============ Knowledge base (PageVault) ============
# Collection names as they exist in YOUR PageVault instance (list them:
# GET /rag/collections). The chat UI lets users pick these per question.
RAG_TEXT_COLLECTION=code
RAG_PAGE_COLLECTION=default

# ============ Infrastructure ============
DATABASE_URL=postgresql+psycopg://stm32ai:stm32ai@stm32-postgres:5432/stm32ai
REDIS_URL=redis://stm32-redis:6379/0
QDRANT_URL=http://stm32-qdrant:6333

# NOTE: the hostnames above are container aliases and the ports are
# CONTAINER-internal. They are unrelated to the host ports below and must not
# be changed when you remap host ports.

# Postgres container init
POSTGRES_USER=stm32ai
POSTGRES_PASSWORD=stm32ai
POSTGRES_DB=stm32ai

# ============ Host ports ============
# Only the host side. 19xxx is unassigned by IANA and sits below the Linux
# ephemeral range (32768+), so it will not collide with a stock Postgres or
# Redis already running on the machine. Leave these commented to accept the
# defaults shown; uncomment only what you need to move.
#
# FRONTEND_PORT=19300     # dashboard + chat UI, published on 0.0.0.0
# BACKEND_PORT=19800      # FastAPI, published on 0.0.0.0
# PAGEVAULT_PORT=19100    # PageVault API (knowledge base)
# POSTGRES_PORT=19432
# REDIS_PORT=19379
# QDRANT_PORT=19333
# QDRANT_GRPC_PORT=19334
# OLLAMA_PORT=19434
#
# Datastores bind to loopback only, because POSTGRES_PASSWORD defaults to
# `stm32ai`. Change the password first if you ever set this to 0.0.0.0.
# INFRA_BIND=127.0.0.1

# ============ Frontend ============
# LEAVE THIS UNSET for a local-only stack: it then follows BACKEND_PORT
# automatically. This value is compiled into the browser bundle, so on a real
# server it must be the URL YOUR BROWSER can reach -- never a container name,
# never localhost.
#   NEXT_PUBLIC_API_URL=http://203.0.113.10:19800
# NEXT_PUBLIC_API_URL=

# ============ CORS ============
# Also unset by default, in which case it follows FRONTEND_PORT. Set it when
# the UI is served from anything other than localhost. Must be a JSON array --
# a comma-separated list makes pydantic-settings fail at startup.
#   CORS_ORIGINS=["http://203.0.113.10:19300"]
# CORS_ORIGINS=
