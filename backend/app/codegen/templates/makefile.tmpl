# Generated by the STM32 engineering assistant. Regenerate rather than edit:
# the source list, include paths and MCU flags all follow from the plan.

TARGET = {{TARGET}}
BUILD = build

PREFIX = arm-none-eabi-
CC = $(PREFIX)gcc
AS = $(PREFIX)gcc -x assembler-with-cpp
CP = $(PREFIX)objcopy
SZ = $(PREFIX)size

CPU = -mcpu={{CPU}}
FPU = -mfpu={{FPU}}
FLOAT_ABI = -mfloat-abi={{FLOAT_ABI}}
MCU = $(CPU) -mthumb $(FPU) $(FLOAT_ABI)

C_DEFS = -D{{DEFINE}} -DUSE_HAL_DRIVER

C_INCLUDES = \
{{C_INCLUDES}}

C_SOURCES = \
{{C_SOURCES}}

ASM_SOURCES = \
{{ASM_SOURCES}}

# -Og keeps the generated code debuggable and, more importantly here, keeps
# warnings honest: -O0 hides uninitialised-variable warnings the repair loop
# depends on.
OPT = -Og
WARN = -Wall -Wextra -Wno-unused-parameter
CFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) $(WARN) -g -gdwarf-2 \
	-fdata-sections -ffunction-sections
ASFLAGS = $(MCU) $(OPT) -Wall -g -gdwarf-2 -fdata-sections -ffunction-sections

LDSCRIPT = {{LDSCRIPT}}
LIBS = -lc -lm -lnosys
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) $(LIBS) \
	-Wl,-Map=$(BUILD)/$(TARGET).map,--cref -Wl,--gc-sections

OBJECTS = $(addprefix $(BUILD)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
OBJECTS += $(addprefix $(BUILD)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))

all: $(BUILD)/$(TARGET).elf $(BUILD)/$(TARGET).hex $(BUILD)/$(TARGET).bin

$(BUILD)/%.o: %.c Makefile | $(BUILD)
	$(CC) -c $(CFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" $< -o $@

$(BUILD)/%.o: %.s Makefile | $(BUILD)
	$(AS) -c $(ASFLAGS) $< -o $@

$(BUILD)/$(TARGET).elf: $(OBJECTS) Makefile
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD)/%.hex: $(BUILD)/%.elf | $(BUILD)
	$(CP) -O ihex $< $@

$(BUILD)/%.bin: $(BUILD)/%.elf | $(BUILD)
	$(CP) -O binary -S $< $@

$(BUILD):
	mkdir -p $@

clean:
	-rm -rf $(BUILD)

-include $(wildcard $(BUILD)/*.d)

.PHONY: all clean
